{
  "name": "devops",
  "version": "1.0.0",
  "description": "Sample TypeScript application for a Jenkins, SonarQube and Nexus CI/CD pipeline.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "test:watch": "vitest",
    "sonar": "sonar-scanner"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "sonar-scanner": "^3.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
